# GEMINI_API_KEY: Optional workspace Gemini API key injected by AI Studio Secrets.
# Users can also supply their own provider keys securely via the Connection Center (BYOK).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

# CREDENTIAL_ENCRYPTION_KEY: 32-byte (64-hex or base64) AES-256-GCM key used by server.ts
# to encrypt user-supplied provider API keys at rest.
# If omitted in local development, the server generates and persists a local key in .data/master.key.
CREDENTIAL_ENCRYPTION_KEY=""

# Optional Admin-managed API keys for Premium tier users (never expose to client VITE_ vars):
ADMIN_GEMINI_API_KEY=""
ADMIN_GROQ_API_KEY=""
ADMIN_OPENROUTER_API_KEY=""
ADMIN_COHERE_API_KEY=""

# Optional T.U.T. Money Lending Authority (MLA) / Wallet Firebase & Hosted Checkout link:
TUT_FIREBASE_PROJECT_ID=""
TUT_FIREBASE_DATABASE_ID="(default)"
TUT_FIREBASE_API_KEY=""
TUT_FIREBASE_AUTH_DOMAIN=""
TUT_FIREBASE_APP_ID=""
TUT_FIREBASE_STORAGE_BUCKET=""
TUT_FIREBASE_MESSAGING_SENDER_ID=""
TUT_PAYMENT_CHECKOUT_URL=""
TUT_VERIFY_RECEIPT_URL=""
MLA_FIREBASE_PROJECT_ID=""
MLA_FIRESTORE_DATABASE_ID="(default)"
MLA_MEMBERS_COLLECTION="members"
MLA_EMAIL_FIELD="email"
MLA_BALANCE_FIELD="balance"
